{
  "name": "onyx",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/asset-integrity.mjs && node website/static-routes.mjs && node tests/e2e/check-production.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "test:production-styles": "node tests/e2e/production-styles.mjs",
    "test:voice:setup": "node tests/e2e/setup.mjs",
    "test:voice": "node tests/e2e/run.mjs",
    "emails": "node supabase/templates/src/build.mjs",
    "start": "node server.js",
    "predev": "node scripts/licenses.mjs && node website/build.mjs",
    "prebuild": "node scripts/licenses.mjs && node website/build.mjs"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/orbitron": "^5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "clsx": "^2.1.1",
    "country-flag-emoji-polyfill": "^0.1.10",
    "immer": "^11.1.21",
    "livekit-client": "2.22.4",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "postcss": "8.5.30",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "main": "server.js",
  "license": "AGPL-3.0-only",
  "author": "rayvn"
}
